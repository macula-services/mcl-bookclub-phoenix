#!/bin/sh
# Erlang distribution: long name on loopback only, and a cookie the BOX
# supplies. A mix release otherwise ships the random cookie it generated at
# build time, which makes it the same for every container of this image, and
# the image is public. With host networking, loopback-only distribution plus a
# per-box cookie is what keeps `bin/mcl_bookclub_phoenix remote` to the box's
# own operator.
#
# The box's secret file names it MCL_COOKIE, like every other mcl-* service in
# the fleet (one convention for the operator); the release's own variable is
# RELEASE_COOKIE. This file is where the two meet.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-mcl_bookclub_phoenix@127.0.0.1}"
export ERL_EPMD_ADDRESS=127.0.0.1

if [ -z "${MCL_COOKIE:-}" ]; then
  echo "mcl-bookclub-phoenix: MCL_COOKIE is not set; give this box its own cookie (see the fleet repo's compose)" >&2
  exit 1
fi

export RELEASE_COOKIE="${MCL_COOKIE}"

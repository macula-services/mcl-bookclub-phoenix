<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>{assigns[:page_title] || "mcl-bookclub"}</title>
    <style>
      :root {
        --ink: #1a1d21; --muted: #6b7280; --paper: #faf9f7; --card: #ffffff;
        --line: #e5e3df; --accent: #b45309; --ok: #15803d; --err: #b91c1c;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; font: 15px/1.55 system-ui, sans-serif; color: var(--ink);
        background: var(--paper);
      }
      header { padding: 1.5rem 2rem 1rem; border-bottom: 1px solid var(--line); }
      header h1 { margin: 0; font-size: 1.4rem; }
      header p { margin: .25rem 0 0; color: var(--muted); font-size: .85rem; }
      main { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
             gap: 1rem; padding: 1.5rem 2rem 3rem; max-width: 1400px; }
      section.task {
        background: var(--card); border: 1px solid var(--line); border-radius: 8px;
        padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: .6rem;
      }
      section.task h2 { margin: 0; font-size: 1rem; border-bottom: 1px solid var(--line);
                         padding-bottom: .5rem; }
      section.task p { margin: 0; color: var(--muted); font-size: .8rem; }
      section.task form { display: flex; flex-direction: column; gap: .6rem; }
      label { display: flex; flex-direction: column; gap: .2rem; font-size: .8rem;
              color: var(--muted); }
      input, select { font: inherit; padding: .35rem .5rem; border: 1px solid var(--line);
              border-radius: 6px; background: #fff; }
      button {
        font: inherit; font-weight: 600; padding: .45rem .8rem; border: 0;
        border-radius: 6px; background: var(--accent); color: #fff; cursor: pointer;
        align-self: flex-start;
      }
      button:hover { filter: brightness(1.1); }
      section.lookup, section.feed { grid-column: 1 / -1; }
      .lookup-row { flex-direction: row; gap: .6rem; flex-wrap: wrap; align-items: end; }
      .lookup-row select { align-self: stretch; }
      pre.lookup-result {
        background: #fff; border: 1px solid var(--line);
        border-radius: 8px; padding: 1rem; overflow-x: auto;
        font: 12px/1.5 ui-monospace, monospace; white-space: pre-wrap;
        word-break: break-word; margin: 0;
      }
      section.feed ul { margin: 0; padding: 0; list-style: none;
                        font: 12px/1.6 ui-monospace, monospace; }
      section.feed li { border-bottom: 1px solid var(--line); padding: .3rem 0; }
      .at { color: var(--muted); margin-right: .6rem; }
      .flash { grid-column: 1 / -1; margin: 0; padding: .6rem 1rem;
               border-radius: 8px; font-size: .9rem; cursor: pointer; }
      .ok { color: var(--ok); background: #dcfce7; }
      .err { color: var(--err); background: #fee2e2; }
      .hint { color: var(--muted); font-size: .78rem; }
    </style>
  </head>
  <body>
    {@inner_content}
    <script defer src={"/assets/app.js?v=" <> MclBookclubPhoenixWeb.BuildInfo.asset_version()}>
    </script>
  </body>
</html>
